# TrailPack – example configuration. Copy to .env (never commit real values).
# The mobile/web app works without any of these (free providers by default).

# --- TrailPack API server (apps/api) — see apps/api/.env.example for the full list
TRAILPACK_API_URL=http://localhost:8787

# --- Optional provider keys (server side, used by the AI proxy)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# --- Optional Android release signing (Gradle reads these at build time)
TRAILPACK_UPLOAD_STORE_FILE=
TRAILPACK_UPLOAD_STORE_PASSWORD=
TRAILPACK_UPLOAD_KEY_ALIAS=
TRAILPACK_UPLOAD_KEY_PASSWORD=
