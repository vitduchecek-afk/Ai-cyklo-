# TrailPack API – copy to .env and adjust. Never commit real keys.

# Network
PORT=8787
HOST=127.0.0.1
# Set to true only when the API runs behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Comma separated list of allowed browser origins (empty = no CORS headers).
CORS_ORIGINS=http://localhost:8081

# Storage: PostgreSQL when DATABASE_URL is set, otherwise SQLite at SQLITE_PATH.
# DATABASE_URL=postgres://user:password@localhost:5432/trailpack
SQLITE_PATH=./data/trailpack.sqlite

# AI proxy – leave a key empty to disable that provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# provider/model entries, a trailing * matches dated snapshots.
AI_ALLOWED_MODELS=anthropic/claude-sonnet-5-5*,anthropic/claude-haiku-5-5*
AI_MONTHLY_BUDGET_USD_PER_USER=5

# Limits
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_PER_HOUR=20
MAX_BODY_BYTES=1048576
MAX_AI_BODY_BYTES=8388608
